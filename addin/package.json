{
  "name": "@plain-language/addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plain Language task-pane add-in for Microsoft Word.",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "dev": "vite",
    "dev-server": "vite",
    "start": "office-addin-debugging start manifest.xml desktop --app word --dev-server \"npm run dev-server\" --dev-server-port 3000",
    "start:web": "office-addin-debugging start manifest.xml web --app word --dev-server \"npm run dev-server\" --dev-server-port 3000",
    "stop": "office-addin-debugging stop manifest.xml",
    "certs": "office-addin-dev-certs install",
    "validate": "office-addin-manifest validate manifest.xml",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@untitledui/icons": "^0.0.23",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/office-js": "^1.0.616",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.0",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
