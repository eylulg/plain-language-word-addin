{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@eylulg/ui", "lucide-react"]
    },
    "addin": {
      "entry": ["src/**/__tests__/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "server": {
      "entry": ["src/index.ts", "src/worker.ts", "src/__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
