# Leave empty to run in demo mode with fixture rewrites.
ANTHROPIC_API_KEY=

# Model used when the add-in does not ask for one.
REWRITE_MODEL=claude-sonnet-5-5
# Models the add-in may ask for, comma separated.
REWRITE_ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5
# low, medium or high. Low is fast and cheap and is enough for one paragraph.
REWRITE_EFFORT=low

# Origins allowed by CORS. Use the URL the add-in is hosted on.
ALLOWED_ORIGINS=https://localhost:3100

RATE_LIMIT_PER_MINUTE=10
MAX_BODY_KB=16
MAX_TEXT_CHARS=4000

PORT=8787
# Set to false to serve plain HTTP in development.
HTTPS=true
# Set to true behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false
