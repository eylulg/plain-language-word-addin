{
  "name": "@plain-language/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rewrite API for the Plain Language Word add-in. Hono on Node, Vercel or Cloudflare Workers.",
  "main": "dist/node.js",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "start": "node dist/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "office-addin-dev-certs": "^3.0.1",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
