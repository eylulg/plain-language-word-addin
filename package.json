{
  "name": "plain-language-word-addin",
  "version": "0.1.0",
  "private": true,
  "description": "A Microsoft Word add-in that scores readability and rewrites paragraphs in plain language with Claude.",
  "license": "MIT",
  "author": "Eylül Güneş",
  "type": "module",
  "workspaces": [
    "addin",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "dev:addin": "npm run dev -w addin",
    "dev:server": "npm run dev -w server",
    "start": "npm run start -w addin",
    "relink": "rm -rf node_modules/@eylulg/ui && npm install ../ui --install-links && git checkout -- package-lock.json",
    "prepare": "husky",
    "knip": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@eylulg/ui": "file:../ui",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.71.0"
  }
}
